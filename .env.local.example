# Google OAuth (Gmail API scopes)
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API and set redirect URI to: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Outlook / Microsoft 365 + personal @outlook.com / @hotmail.com)
# See README "Microsoft / Outlook setup" for the step-by-step Azure app registration.
# Use AZURE_AD_TENANT_ID=common to accept both work/school and personal accounts.
# When both AZURE_AD_CLIENT_ID and AZURE_AD_CLIENT_SECRET are set, the sign-in page
# automatically shows a "Continue with Microsoft" button. Leave both empty to hide it.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# Database — Vercel Postgres (https://vercel.com/dashboard → Storage → Create Database)
# After creating, copy the DATABASE_URL from the database's `.env.local` tab.
# DATABASE_URL=postgres://default:xxxx@xxxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# AI provider — OpenAI-compatible endpoint.
# Default recommendation: Groq (free, 14,400 requests/day, no credit card).
# Get a key at https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=

# --- Alternatives (uncomment + set AI_API_KEY to switch) ---
# OpenRouter (free tier: ~50 req/day per model, 20 RPM, no credit card)
# Free model IDs end with :free, e.g. meta-llama/llama-3.3-70b-instruct:free
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_API_KEY=

# Cerebras (free tier: 1M tokens/day, very fast)
# AI_BASE_URL=https://api.cerebras.ai/v1
# AI_MODEL=llama-3.3-70b
# AI_API_KEY=
